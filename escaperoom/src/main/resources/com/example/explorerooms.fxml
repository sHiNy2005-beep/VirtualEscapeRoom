<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>

<Pane fx:id="rootPane" prefHeight="600.0" prefWidth="900.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ExploreRoomsController">

    <children>
        <Label fx:id="titleLabel" layoutX="18.0" layoutY="8.0" text="EXPLORE HAMTON MANSION" />

        <MenuBar layoutX="16.0" layoutY="56.0" prefWidth="220.0">
            <menus>
                <Menu text="Home">
                    <items>
                        <MenuItem fx:id="menuClose" text="Close" />
                    </items>
                </Menu>
                <Menu text="Rooms">
                    <items>
                        <MenuItem fx:id="menuDelete" text="Delete" />
                    </items>
                </Menu>
                <Menu text="Items">
                    <items>
                        <MenuItem fx:id="menuAbout" text="About" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <ImageView fx:id="imgLibrary" fitHeight="180.0" fitWidth="180.0" layoutX="80.0" layoutY="100.0" pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@../../images/LibraryRoom.jpg" />
            </image>
        </ImageView>
        <Label layoutX="90.0" layoutY="100.0" prefHeight="43.0" prefWidth="170.0" styleClass="card-title" text="LIBRARY" />

        <ImageView fx:id="imgGarden" fitHeight="180.0" fitWidth="180.0" layoutX="344.0" layoutY="100.0" pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@../../images/GardenRoom.png" />
            </image>
        </ImageView>
        <Label layoutX="354.0" layoutY="100.0" prefHeight="43.0" prefWidth="170.0" styleClass="card-title" text="GARDEN" />

        <ImageView fx:id="imgBedroom" fitHeight="180.0" fitWidth="180.0" layoutX="620.0" layoutY="100.0" pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@../../images/bedroom.png" />
            </image>
        </ImageView>
        <Label layoutX="630.0" layoutY="100.0" prefHeight="43.0" prefWidth="160.0" styleClass="card-title" text="BEDROOM" />

        <ImageView fx:id="imgStudy" fitHeight="180.0" fitWidth="180.0" layoutX="222.0" layoutY="310.0" pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@../../images/StudyRoom.png" />
            </image>
        </ImageView>
        <Label layoutX="232.0" layoutY="310.0" prefHeight="33.0" prefWidth="160.0" styleClass="card-title" text="STUDY" />

        <ImageView fx:id="imgDining" fitHeight="180.0" fitWidth="180.0" layoutX="498.0" layoutY="310.0" pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@../../images/DiningRoom.png" />
            </image>
        </ImageView>
        <Label fx:id="diningLock" layoutX="566.0" layoutY="359.0" opacity="0.76" prefHeight="97.0" prefWidth="58.0" styleClass="lock-badge" text="🔒" />
        <Label layoutX="505.0" layoutY="310.0" prefHeight="33.0" prefWidth="180.0" styleClass="card-title" text="DINING ROOM" />

        <Button fx:id="backButton" layoutX="16.0" layoutY="540.0" mnemonicParsing="false" text="&lt; BACK" />

        <Label layoutX="820.0" layoutY="25.0" styleClass="clock" text="⏱ 08:45" />
    </children>
</Pane>
