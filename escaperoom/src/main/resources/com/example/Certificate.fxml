<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="746.0" prefWidth="486.0" styleClass="room-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.CertificateController">
   <children>

      <ImageView fx:id="certificateImage" fitHeight="770.0" fitWidth="672.0" layoutX="-7.0" layoutY="-24.0" pickOnBounds="true" preserveRatio="true" styleClass="safe">
         <image>
            <Image url="@../../images/certificateImage.png" />
         </image>
      </ImageView>

      <Button fx:id="closeButton" layoutX="186.0" layoutY="616.0" mnemonicParsing="false" onAction="#onCloseButton" prefHeight="37.0" prefWidth="128.0" text="Close Certificate">
         <style>
            -fx-background-radius:6;
             -fx-padding:10 18 10 18;
             -fx-background-color: linear-gradient(#c99e2b, #8f6608);
             -fx-text-fill:white;
             -fx-font-weight:bold;
         </style>
      </Button>
   </children>
</AnchorPane>
