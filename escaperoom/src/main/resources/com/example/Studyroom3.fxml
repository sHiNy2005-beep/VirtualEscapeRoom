<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" styleClass="room-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.StudyRoom3Controller">

    <children>

        <Label fx:id="titleLabel" layoutX="18.0" layoutY="12.0" text="STUDY">
            <font>
                <Font name="Book Antiqua" size="48.0" />
            </font>
            <style>
                -fx-text-fill: white;
                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.75), 6, 0, 0, 2);
            </style>
        </Label>

        
        <MenuBar layoutX="16.0" layoutY="64.0" prefWidth="300.0">
            <menus>
                <Menu text="Home">
                    <items>
                        <MenuItem fx:id="menuHome" onAction="#onMenuHome" text="Home" />
                    </items>
                </Menu>
                <Menu text="Rooms">
                    <items>
                        <MenuItem fx:id="menuRooms" onAction="#onMenuRooms" text=" Rooms" />
                    </items>
                </Menu>
                <Menu text="Items">
                    <items>
                        <MenuItem fx:id="menuItems" onAction="#onMenuItems" text="Items" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        
        <Pane layoutX="40.0" layoutY="110.0" prefHeight="440.0" prefWidth="820.0" style="-fx-background-color:#3a3a3a; -fx-border-radius:4; -fx-background-radius:4;">
            <children>

               
                <Label fx:id="storyLabel" layoutX="36.0" layoutY="28.0" prefWidth="700.0" text="YOU UNLOCKED THE CASE AND NOW A CLUE WILL BE REVEALED TO YOU....INSIDE THE SAFE WERE LEDGERS AND FINANCIAL INFORMATION. MR.BARNER, THE LOYAL BUTLER OF REGINALD HAMTON'S NAME WAS ON MANY DOCUMENTS AS A FIDUCIARY AND TRUSTED CONTACT, HOW MUCH DID HAMTON TRUST MR. BARNER AND DID HE STAB HIM IN THE BACK?......." wrapText="true">
                    <font>
                        <Font name="Book Antiqua" size="20.0" />
                    </font>
                    <style>
                        -fx-text-fill: white;
                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 4, 0, 0, 1);
                        -fx-line-spacing: 2px;
                    </style>
                </Label>

                
                <ImageView fx:id="ledgerImage" fitHeight="120.0" fitWidth="160.0" layoutX="60.0" layoutY="220.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../images/ledger.png" />
                    </image>
                </ImageView>

               
                <ImageView fx:id="keyImage" fitHeight="120.0" fitWidth="120.0" layoutX="260.0" layoutY="220.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../images/key.png" />
                    </image>
                </ImageView>

                
                <Label fx:id="itemsLabel" layoutX="36.0" layoutY="360.0" prefWidth="520.0" text="ITEMS ACQUIRED: SAFE KEY and LEDGER">
                    <font>
                        <Font name="Book Antiqua" size="16.0" />
                    </font>
                    <style>
                        -fx-text-fill: derive(#ffffff, -30%);
                        -fx-opacity: 0.85;
                    </style>
                </Label>

                
                <Label fx:id="scoreLabel" layoutX="760.0" layoutY="381.0" text="+100">
                    <font>
                        <Font name="Book Antiqua" size="36.0" />
                    </font>
                    <style>
                        -fx-text-fill: white;
                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 4, 0, 0, 1);
                    </style>
                </Label>

            </children>
        </Pane>

          
                <Button fx:id="backButton" layoutX="67.0" layoutY="556.0" mnemonicParsing="false" onAction="#onBack" prefHeight="36.0" prefWidth="110.0" text="&lt; BACK">
              <style>
                        -fx-background-radius:8;
                        -fx-padding:6 12 6 12;
                        -fx-background-color: linear-gradient(#ffffff, #dddddd);
                        -fx-text-fill: #222222;
                    </style>
          </Button>

          <Button fx:id="nextButton" layoutX="775.0" layoutY="559.0" mnemonicParsing="false" onAction="#onNext" prefHeight="36.0" prefWidth="110.0" text="NEXT &gt;">
              <style>
                        -fx-background-radius:8;
                        -fx-padding:6 12 6 12;
                        -fx-background-color: linear-gradient(#c99e2b, #8f6608);
                        -fx-text-fill:white;
                        -fx-font-weight:bold;
                    </style>
          </Button>

    </children>

    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>
</AnchorPane>
