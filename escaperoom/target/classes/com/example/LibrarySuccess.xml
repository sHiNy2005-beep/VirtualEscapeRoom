<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: rgba(58, 58, 58, 0.95);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.LibrarySuccessController">
    <children>
        <!-- Title -->
        <Label layoutX="32.0" layoutY="32.0" text="LIBRARY" textFill="WHITE">
            <font>
                <Font name="System Bold" size="36.0" />
            </font>
        </Label>
        
        <!-- Menu items -->
        <Label layoutX="40.0" layoutY="85.0" text="Home" textFill="WHITE">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <Label layoutX="103.0" layoutY="85.0" text="Rooms" textFill="WHITE">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <Label layoutX="190.0" layoutY="85.0" text="Items" textFill="WHITE">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        
        <!-- Success Message -->
        <Label layoutX="97.0" layoutY="180.0" prefWidth="900.0" text="YOU UNLOCKED THE CASE AND NOW A CLUE WILL BE REVEALED TO YOU....INSIDE THE SAFE WERE LEDGERS AND FINANCIAL INFORMATION. MR.BARNER, THE LOYAL BUTLER OF REGINALD HAMPTON'S NAME WAS ON MANY DOCUMENTS AS A FIDUCIARY AND TRUSTED CONTACT, HOW MUCH DID HAMPTON TRUST MR. BARNER AND DID HE STAB HIM IN THE BACK?......" textFill="WHITE" wrapText="true">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        
        <!-- Items Acquired -->
        <HBox layoutX="137.0" layoutY="440.0" spacing="80.0">
            <ImageView fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../images/TornPage.png" />
                </image>
            </ImageView>
            <ImageView fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../images/MagnifyingGlass.png" />
                </image>
            </ImageView>
        </HBox>
        
        <!-- Items Label -->
        <Label layoutX="97.0" layoutY="570.0" text="ITEMS ACQUIRED: TORN WILL PAGE and MAGNIFYING GLASS" textFill="rgba(255,255,255,0.7)">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        
        <!-- Score Label -->
        <Label fx:id="scoreLabel" layoutX="850.0" layoutY="630.0" text="+100" textFill="WHITE">
            <font>
                <Font name="System Bold" size="36.0" />
            </font>
        </Label>
        
        <!-- Back Button -->
        <Button fx:id="backButton" layoutX="86.0" layoutY="704.0" mnemonicParsing="false" onAction="#onBackButton" text="&lt; BACK" styleClass="button-white">
            <font>
                <Font size="14.0" />
            </font>
        </Button>
        
        <!-- Next Button -->
        <Button fx:id="nextButton" layoutX="970.0" layoutY="704.0" mnemonicParsing="false" onAction="#onNextButton" text="NEXT &gt;" styleClass="button-yellow">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>
    </children>
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>
</AnchorPane>