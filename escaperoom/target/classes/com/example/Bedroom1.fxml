<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.BedroomPage1Controller"
            prefWidth="900" prefHeight="600"
            stylesheets="@styles.css">

 
    <center>
        <StackPane>

            <ImageView fx:id="bgImage" fitHeight="585" fitWidth="974" mouseTransparent="true" preserveRatio="false">
                <image>
                    <Image url="@../../images/bedroom1.png" />
                </image>
            </ImageView>

             <VBox alignment="CENTER">
               <BorderPane prefHeight="674.0" prefWidth="1019.0" style="-fx-padding: 18;">
                   <top>
                       <VBox spacing="8">
                           <Label styleClass="title" text="BEDROOM" textFill="WHITE">
                        <font>
                           <Font size="48.0" />
                        </font>
                     </Label>
                           <HBox alignment="CENTER_LEFT" prefHeight="11.0" prefWidth="702.0" spacing="16" styleClass="nav-links">
                               <Label styleClass="nav-item" text="Home" textFill="WHITE">
                           <font>
                              <Font size="15.0" />
                           </font>
                        </Label>
                               <Label styleClass="nav-item active" text="Rooms" textFill="WHITE">
                           <font>
                              <Font size="15.0" />
                           </font>
                        </Label>
                           </HBox>
                       </VBox>
                   </top>
   
                   <bottom>
                       <BorderPane style="-fx-padding: 8;">
                           <left>
                               <Button fx:id="backBtn" onAction="#onBack" styleClass="nav-btn" text="&lt; BACK" />
                           </left>
                           <right>
                               <Button fx:id="nextBtn" onAction="#onNext" styleClass="nav-btn" text="NEXT &gt;" />
                           </right>
                       </BorderPane>
                   </bottom>
               <left>
                      <Label contentDisplay="BOTTOM" maxWidth="600" opacity="0.66" style="-fx-font-size: 22px;                             -fx-font-weight: bold;                             -fx-text-fill: white;                             -fx-effect: dropshadow(gaussian, black, 8, 0, 0, 2);                             -fx-padding: 20;                             -fx-background-color: rgba(0,0,0,0.45);                             -fx-background-radius: 12;" text="As soon as you enter.. the sheets catch your attention then you look at the wall..." textFill="#00000067" textOverrun="CLIP" wrapText="true" BorderPane.alignment="CENTER">
                     <font>
                        <Font size="10.0" />
                     </font>
                  </Label>
               </left>
               </BorderPane>
            </VBox>
            

        </StackPane>
    </center>

</BorderPane>
