<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.BedroomPage1Controller"
            prefWidth="900" prefHeight="600"
            stylesheets="@styles.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar" padding="12,24,12,24">
            <Label text="Bedroom" styleClass="title"/>
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="nav-links">
                <Label text="Home" styleClass="nav-item"/>
                <Label text="Rooms" styleClass="nav-item active"/>
                <Label text="Items" styleClass="nav-item"/>
            </HBox>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="clockLabel" text="08:45" styleClass="clock"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="rootStack" styleClass="room-root">
            <ImageView fx:id="bgImage" fitWidth="900" fitHeight="600" preserveRatio="false" pickOnBounds="true" mouseTransparent="true">
                <image>
                    <Image url="@../images/bedroom.png"/>
                </image>
            </ImageView>

            <AnchorPane prefWidth="900" prefHeight="600">

                <Label fx:id="descriptionLabel"
                       layoutX="50" layoutY="110"
                       prefWidth="540"
                       wrapText="true"
                       styleClass="description"/>

                <HBox layoutX="230" layoutY="315" spacing="0" styleClass="page-toggle">
                    <Button fx:id="pageBtn1" text="1" onAction="#onPage1" styleClass="page-btn page-active"/>
                    <Button fx:id="pageBtn2" text="2" onAction="#onPage2" styleClass="page-btn"/>
                    <Button fx:id="pageBtn3" text="3" onAction="#onPage3" styleClass="page-btn"/>
                </HBox>

                <Button fx:id="backBtn" layoutX="20" layoutY="520" text="&lt; BACK" onAction="#onBack" styleClass="nav-btn"/>
                <Button fx:id="nextBtn" layoutX="760" layoutY="520" text="NEXT &gt;" onAction="#onNext" styleClass="nav-btn"/>

            </AnchorPane>
        </StackPane>
    </center>

</BorderPane>
