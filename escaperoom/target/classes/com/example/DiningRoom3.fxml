<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" styleClass="dining-room-background" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.DiningRoom3Controller">

    <children>

        <Label fx:id="titleLabel" layoutX="18.0" layoutY="12.0" text="Dining Room">
            <font>
                <Font name="Book Antiqua" size="48.0" />
            </font>
            <style>
                -fx-text-fill: white;
                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.75), 6, 0, 0, 2);
            </style>
        </Label>

        
        <MenuBar layoutX="16.0" layoutY="64.0" prefWidth="300.0">
            <menus>
                <Menu text="Home">
                    <items>
                        <MenuItem fx:id="menuHome" onAction="#onMenuHome" text="Home" />
                    </items>
                </Menu>
                <Menu text="Rooms">
                    <items>
                        <MenuItem fx:id="menuRooms" onAction="#onMenuRooms" text=" Rooms" />
                    </items>
                </Menu>
                <Menu text="Items">
                    <items>
                        <MenuItem fx:id="menuItems" onAction="#onMenuItems" text="Items" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>

          
                <Button fx:id="backButton" layoutX="67.0" layoutY="556.0" mnemonicParsing="false" onAction="#onBack" prefHeight="36.0" prefWidth="110.0" text="&lt; BACK">
              <style>
                        -fx-background-radius:8;
                        -fx-padding:6 12 6 12;
                        -fx-background-color: linear-gradient(#ffffff, #dddddd);
                        -fx-text-fill: #222222;
                    </style>
          </Button>

          <Button fx:id="nextButton" layoutX="775.0" layoutY="559.0" mnemonicParsing="false" onAction="#onNext" prefHeight="36.0" prefWidth="110.0" text="NEXT &gt;">
              <style>
                        -fx-background-radius:8;
                        -fx-padding:6 12 6 12;
                        -fx-background-color: linear-gradient(#c99e2b, #8f6608);
                        -fx-text-fill:white;
                        -fx-font-weight:bold;
                    </style>
          </Button>

         
                <Label fx:id="storyLabel" layoutX="38.0" layoutY="147.0" prefWidth="700.0" text="YOU ARE CORRECT!!!! The culprit was indeed..Ms. Louise,as she killed Mr. Hamton. Lily found out about their affair, Hence the love letter. .. Hamton was going to fire Ms. Louise. The bloody statue was more than enough evidence to catch our killer!!! Congratulations.!" wrapText="true">
              <font>
                  <Font name="Book Antiqua" size="20.0" />
              </font>
              <style>
                        -fx-text-fill: white;
                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 4, 0, 0, 1);
                        -fx-line-spacing: 2px;
                    </style>
          </Label>

          
                <Label fx:id="scoreLabel" layoutX="792.0" layoutY="497.0" text="+100">
              <font>
                  <Font name="Book Antiqua" size="36.0" />
              </font>
              <style>
                        -fx-text-fill: white;
                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 4, 0, 0, 1);
                    </style>
          </Label>

    </children>

    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>
</AnchorPane>
