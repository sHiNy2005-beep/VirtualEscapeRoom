<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane fx:id="rootPane" prefHeight="400.0" prefWidth="589.0" stylesheets="@login.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <ImageView fx:id="backgroundImage" fitHeight="400.0" fitWidth="657.0" layoutX="-4.0" opacity="0.97" preserveRatio="true">
            <image>
                <Image url="@../../../../../../../../../../Downloads/homepagebackground.png" />
            </image>
        </ImageView>

        <Label fx:id="mainTitle" layoutX="20.0" layoutY="20.0" styleClass="header-text" stylesheets="@../../styles.css" text="THE HAMTON MANSION">
            <font>
                <Font name="Book Antiqua" size="38.0" />
            </font>
        </Label>

        <Label fx:id="subTitle" graphicTextGap="3.0" layoutX="30.0" layoutY="80.0" styleClass="subheader-text" text="ESCAPE ROOM">
            <font>
                <Font name="Book Antiqua" size="32.0" />
            </font>
        </Label>

        <Button fx:id="signInButton" layoutX="493.0" layoutY="361.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="75.0" styleClass="button" text="Sign In" />
    </children>
</Pane>
